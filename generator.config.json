{
  "schema": 1,
  "starter": "java-starter",
  "prompts": ["basePackage"],
  "modules": {
    "required": ["api", "domain", "adapter"],
    "optional": [
      {
        "id": "schema",
        "label": "schema",
        "hint": "PostgreSQL persistence (JPA adapter) and the Liquibase changelogs that own its schema",
        "default": true,
        "markers": [
          { "extensions": [".xml", ".md"], "start": "<!-- module:schema -->", "end": "<!-- /module:schema -->" },
          { "extensions": [".yml", ".yaml"], "start": "# module:schema", "end": "# /module:schema" }
        ],
        "whenAbsent": {
          "templates": "without-schema",
          "remove": [
            "compose.yaml",
            "starter-schema",
            "starter-adapter/src/main/java/com/example/starter/adapter/persistence",
            "starter-domain/src/main/java/com/example/starter/domain/model/Position.java",
            "starter-domain/src/main/java/com/example/starter/domain/model/PositionStatus.java",
            "starter-domain/src/main/java/com/example/starter/domain/port/in/CreatePositionUseCase.java",
            "starter-domain/src/main/java/com/example/starter/domain/port/in/GetPositionUseCase.java",
            "starter-domain/src/main/java/com/example/starter/domain/port/out/LoadPositionPort.java",
            "starter-domain/src/main/java/com/example/starter/domain/port/out/SavePositionPort.java",
            "starter-domain/src/main/java/com/example/starter/domain/service/PositionService.java",
            "starter-adapter/src/test/java/com/example/starter/adapter/TestApplication.java",
            "starter-adapter/src/test/java/com/example/starter/adapter/persistence",
            "starter-domain/src/test/java/com/example/starter/domain/service/PositionServiceTest.java",
            "starter-api/src/main/java/com/example/starter/application/controller/PositionController.java",
            "starter-api/src/main/java/com/example/starter/application/mapper/PositionRestMapper.java",
            "starter-api/src/main/java/com/example/starter/infrastructure/config/PositionDomainConfig.java",
            "starter-api/src/test/java/com/example/starter/application/controller/PositionControllerTest.java",
            "starter-api/src/test/java/com/example/starter/PersistenceArchitectureTest.java",
            "starter-api/src/test/java/com/example/starter/ApplicationIT.java",
            "starter-api/src/test/java/com/example/starter/cucumber/CucumberSpringConfiguration.java"
          ]
        }
      },
      {
        "id": "batch",
        "label": "batch",
        "hint": "Spring Batch application running jobs over the same hexagon (requires schema)",
        "default": false,
        "requires": ["schema"],
        "markers": [
          { "extensions": [".xml", ".md"], "start": "<!-- module:batch -->", "end": "<!-- /module:batch -->" }
        ],
        "whenAbsent": {
          "remove": [
            "starter-batch",
            "starter-domain/src/main/java/com/example/starter/domain/port/in/RevaluePositionUseCase.java",
            "starter-domain/src/main/java/com/example/starter/domain/port/out/LoadOpenPositionsPort.java",
            "starter-domain/src/main/java/com/example/starter/domain/service/RevaluePositionService.java",
            "starter-adapter/src/main/java/com/example/starter/adapter/persistence/repository/OpenPositionJpaRepository.java",
            "starter-adapter/src/main/java/com/example/starter/adapter/persistence/adapter/OpenPositionsPersistenceAdapter.java",
            "starter-domain/src/test/java/com/example/starter/domain/service/RevaluePositionServiceTest.java",
            "starter-adapter/src/test/java/com/example/starter/adapter/persistence/adapter/OpenPositionsPersistenceAdapterIT.java",
            "starter-schema/src/main/resources/db/changelog/changesets/002-spring-batch-metadata.xml",
            "starter-schema/src/main/resources/db/changelog/sql"
          ]
        }
      }
    ]
  },
  "copyIgnore": [
    ".git",
    ".idea",
    ".vscode",
    "target",
    "starter-domain/target",
    "starter-adapter/target",
    "starter-api/target",
    "starter-schema/target",
    "starter-batch/target",
    ".claude/settings.local.json"
  ],
  "remove": [
    "CHANGELOG.md",
    "version.txt",
    "LICENSE",
    ".github/CODE_OF_CONDUCT.md",
    ".github/CONTRIBUTING.md",
    ".github/SECURITY.md",
    ".github/ISSUE_TEMPLATE",
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".github/workflows/release-please.yml"
  ],
  "rename": [
    { "from": "starter-domain", "to": "{{appName}}-domain" },
    { "from": "starter-adapter", "to": "{{appName}}-adapter" },
    { "from": "starter-api", "to": "{{appName}}-api" },
    { "module": "schema", "from": "starter-schema", "to": "{{appName}}-schema" },
    { "module": "batch", "from": "starter-batch", "to": "{{appName}}-batch" },
    {
      "from": "{{appName}}-domain/src/main/java/com/example/starter",
      "to": "{{appName}}-domain/src/main/java/{{basePackagePath}}"
    },
    {
      "from": "{{appName}}-domain/src/test/java/com/example/starter",
      "to": "{{appName}}-domain/src/test/java/{{basePackagePath}}"
    },
    {
      "from": "{{appName}}-adapter/src/main/java/com/example/starter",
      "to": "{{appName}}-adapter/src/main/java/{{basePackagePath}}"
    },
    {
      "from": "{{appName}}-adapter/src/test/java/com/example/starter",
      "to": "{{appName}}-adapter/src/test/java/{{basePackagePath}}"
    },
    {
      "from": "{{appName}}-api/src/main/java/com/example/starter",
      "to": "{{appName}}-api/src/main/java/{{basePackagePath}}"
    },
    {
      "from": "{{appName}}-api/src/test/java/com/example/starter",
      "to": "{{appName}}-api/src/test/java/{{basePackagePath}}"
    },
    {
      "module": "batch",
      "from": "{{appName}}-batch/src/main/java/com/example/starter",
      "to": "{{appName}}-batch/src/main/java/{{basePackagePath}}"
    },
    {
      "module": "batch",
      "from": "{{appName}}-batch/src/test/java/com/example/starter",
      "to": "{{appName}}-batch/src/test/java/{{basePackagePath}}"
    }
  ],
  "replace": [
    {
      "file": "{{appName}}-api/openapi/openapi.yaml",
      "search": "java-starter API",
      "value": "{{title}} API",
      "optional": true
    }
  ],
  "replaceAll": [
    {
      "extensions": [".java", ".xml", ".yml", ".yaml"],
      "search": "com.example.starter",
      "value": "{{basePackage}}"
    },
    { "extensions": [".xml"], "search": ">starter-aggregator<", "value": ">{{appName}}-aggregator<" },
    { "extensions": [".xml"], "search": ">starter-domain<", "value": ">{{appName}}-domain<" },
    { "extensions": [".xml"], "search": ">starter-adapter<", "value": ">{{appName}}-adapter<" },
    { "extensions": [".xml"], "search": ">starter-api<", "value": ">{{appName}}-api<" },
    { "extensions": [".xml"], "search": ">starter-schema<", "value": ">{{appName}}-schema<" },
    { "extensions": [".xml"], "search": ">starter-batch<", "value": ">{{appName}}-batch<" },
    { "extensions": [".xml"], "search": "starter-domain.version", "value": "{{appName}}-domain.version" },
    { "extensions": [".xml"], "search": "starter-adapter.version", "value": "{{appName}}-adapter.version" },
    { "extensions": [".xml"], "search": "starter-schema.version", "value": "{{appName}}-schema.version" },
    { "extensions": [".yml"], "search": "starter-api", "value": "{{appName}}-api" },
    { "module": "batch", "extensions": [".yml"], "search": "starter-batch", "value": "{{appName}}-batch" }
  ],
  "openapiTarget": "{{appName}}-api/openapi/openapi.yaml",
  "install": {
    "default": "./mvnw -ntp -B -DskipTests package",
    "win32": ".\\mvnw.cmd -ntp -B -DskipTests package"
  },
  "postInstall": [
    {
      "default": "./mvnw -ntp -B spotless:apply",
      "win32": ".\\mvnw.cmd -ntp -B spotless:apply"
    }
  ],
  "nextSteps": [
    "Install lefthook (https://lefthook.dev) then run `lefthook install`   (pre-commit Spotless auto-format)",
    "./mvnw verify                            (mvnw.cmd on Windows cmd; needs Docker)",
    {
      "module": "schema",
      "text": "./mvnw liquibase:update -pl {{appName}}-schema   (migrates the local PostgreSQL — no application ever does this itself)"
    },
    "./mvnw spring-boot:run -pl {{appName}}-api",
    {
      "module": "batch",
      "text": "./mvnw spring-boot:run -pl {{appName}}-batch   (runs the demo job, then exits)"
    },
    "Provided --openapi? Align the controllers with the regenerated interfaces (compile errors point the way)."
  ]
}
